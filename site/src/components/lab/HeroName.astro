---
// Hero lab B · "Through the name": the tower shows only through the letters of the name; the scroll flies
// through a letter until the photo fills the screen. Without the motion script it is the plain photo hero.
import Facts from '../Facts.astro';
import ArtPicture from '../ArtPicture.astro';
import { project as p } from '../../data/new-casa-suites';
import { rm, sgd } from '../../lib/format';
---
<section class="nm" id="top" aria-label={p.name}>
  <div class="nm-stage">
    <div class="nm-photo"><ArtPicture wide={p.img.hero} tall={p.img.heroPortrait} alt={`${p.name} at dusk, artist's impression`} eager /></div>
    <div class="nm-shade"></div>
    <svg class="nm-veil" aria-hidden="true">
      <defs>
        <mask id="nm-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
          <rect width="100%" height="100%" fill="#fff" />
          <g class="nm-words"><text class="w1" text-anchor="middle">New Casa</text><text class="w2" text-anchor="middle">Suites</text></g>
        </mask>
      </defs>
      <rect class="nm-paper" width="100%" height="100%" mask="url(#nm-mask)" />
    </svg>
    <div class="nm-top"><div class="eyebrow"><span class="rule"></span>{p.area}</div><div class="mono">{p.coord}</div></div>
    <div class="nm-foot"><p>{p.intro}</p><div class="j-cue"><i></i>Scroll</div></div>

    <div class="nm-title">
      <div class="eyebrow"><span class="rule"></span>{p.area}</div>
      <h1>New Casa <em>Suites</em></h1>
      <p>{p.intro}</p>
    </div>

    <Facts project={p} />
    <div class="j-mfacts"><div class="p"><small>From</small><b>{rm(p.priceFrom)}</b><span>≈ {sgd(p.priceFrom)}</span></div><div><small>Beds · baths</small><b>Studio–4 · 1–3</b></div><div><small>Size</small><b>313–1,555 sf</b></div></div>
  </div>
</section>

<style>
  .nm{position:relative;background:var(--ivory)}
  .nm-stage{position:relative;height:100vh;height:100svh;min-height:560px;overflow:hidden}
  .nm-photo{position:absolute;inset:0}
  .nm-photo :global(picture),.nm-photo :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%}
  .nm-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgb(20 19 18/.45) 0%,rgb(20 19 18/0) 28%,rgb(20 19 18/0) 50%,rgb(20 19 18/.6) 100%)}
  .nm-veil{position:absolute;inset:0;width:100%;height:100%;z-index:3;display:none}
  .nm-paper{fill:var(--ivory)}
  .nm-words text{font-family:var(--fd);font-weight:560;letter-spacing:-.03em}
  .nm-words .w2{font-style:italic;font-weight:500}
  .nm-top,.nm-foot{position:absolute;left:3vw;right:3vw;z-index:4;color:var(--char);display:none}
  .nm-top{top:calc(var(--nav-h) + 1.2rem);justify-content:space-between;align-items:baseline}
  .nm-foot{bottom:calc(150px + 3%);justify-content:space-between;align-items:flex-end;gap:2rem}
  .nm-foot p{max-width:26rem;color:var(--mut-2)}
  .nm-foot .j-cue{color:var(--mut);margin:0}
  .nm-foot .j-cue i{background:linear-gradient(var(--char),transparent)}
  .nm-title{position:absolute;left:3vw;bottom:calc(170px + 5%);z-index:4;color:#fff;max-width:min(52vw,46rem)}
  .nm-title .eyebrow{color:#F1E6DA}
  .nm-title .rule{background:#F1E6DA}
  .nm-title h1{font:400 clamp(3rem,6.4vw,5.75rem)/1.02 var(--fd);letter-spacing:-.018em;margin:.8rem 0 .9rem}
  .nm-title h1 em{font-style:italic;color:#F3E3D2}
  .nm-title p{font-size:1.04rem;max-width:30rem;opacity:.95}
  .nm :global(.facts){position:absolute;left:3vw;right:3vw;bottom:22px;z-index:6}
  /* the veil and its lines only exist while the motion script runs */
  :global(html.motion) .nm-veil{display:block}
  :global(html.motion) .nm-top,:global(html.motion) .nm-foot{display:flex}
  :global(html.motion) .nm-title{opacity:0;visibility:hidden}
  :global(body:has(.nm)) :global(.nav.over){--nav-fg:var(--char)}

  @media (max-width:760px){
    .nm-top{flex-direction:column;gap:.3rem}
    .nm-foot{bottom:calc(76px + 64px + 1.4rem + env(safe-area-inset-bottom));flex-direction:column;align-items:flex-start;gap:.8rem}
    .nm-foot p{font-size:.92rem}
    .nm-title{left:1.2rem;right:1.2rem;bottom:calc(76px + 64px + 1.8rem + env(safe-area-inset-bottom));max-width:none}
    .nm-title h1{font-size:clamp(2.7rem,13vw,3.4rem)}
    .nm :global(.facts){display:none}
  }
</style>

<script>
  import { gsap, ScrollTrigger, motionOn } from '../../scripts/motion';

  const nm = document.querySelector<HTMLElement>('.nm');
  if (nm && motionOn) {
    const q = gsap.utils.selector(nm);
    const stage = q('.nm-stage')[0] as HTMLElement;
    const svg = q('.nm-veil')[0] as SVGSVGElement;
    const words = q('.nm-words')[0] as SVGGElement;
    const [w1, w2] = q('.nm-words text') as SVGTextElement[];
    const nav = document.getElementById('nav')!;
    let origin = { x: 0, y: 0 };

    // set the two lines as large as the screen allows, then find a point inside a stroke of the "N" to fly into
    const layout = () => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const phone = W <= 760;
      const fs = phone ? Math.min(W * 0.225, H * 0.14) : Math.min(W * 0.2, H * 0.36);
      const cy = H * (phone ? 0.47 : 0.5);
      for (const t of [w1, w2]) { t.style.fontSize = fs + 'px'; t.setAttribute('x', String(W / 2)); }
      w1.setAttribute('y', String(cy - fs * 0.06));
      w2.setAttribute('y', String(cy + fs * 0.86));
      const b = w1.getBBox();
      origin = stem(b.x, b.y, b.height, fs, cy - fs * 0.06);
    };
    // draw line 1 on a canvas with the same font and find its thickest point: the most ink in both directions
    // (a crossbar is long but thin, a stem is tall but narrow; the fly-through needs ink that is thick both ways)
    let run = 40;
    const stem = (bx: number, by: number, bh: number, fs: number, base: number) => {
      const c = document.createElement('canvas');
      const cw = Math.ceil(fs * 5), ch = Math.ceil(bh);
      c.width = cw; c.height = ch;
      const g = c.getContext('2d', { willReadFrequently: true })!;
      g.font = `560 ${fs}px "Newsreader Variable", Newsreader, Georgia, serif`;
      g.textBaseline = 'alphabetic';
      g.fillText('New Casa', 0, base - by);
      const d = g.getImageData(0, 0, cw, ch).data;
      const ink = (x: number, y: number) => x >= 0 && y >= 0 && x < cw && y < ch && d[(y * cw + x) * 4 + 3] > 180;
      let best = { x: fs * 0.1, y: base - fs * 0.33, n: 0 };
      for (let y = Math.round(base - by - fs * 0.62); y < base - by - fs * 0.12; y += 3) {
        for (let x = 0; x < cw; x += 3) {
          if (!ink(x, y)) continue;
          let l = x, r = x, u = y, w = y;
          while (ink(l - 1, y)) l--;
          while (ink(r + 1, y)) r++;
          while (ink(x, u - 1)) u--;
          while (ink(x, w + 1)) w++;
          const n = Math.min(r - l, w - u);
          if (n > best.n) best = { x: bx + (l + r) / 2, y: by + (u + w) / 2, n };
        }
      }
      run = best.n || 40;
      return { x: best.x, y: best.y };
    };

    // the zoom is written straight into the group's transform, about the point found above
    const z = { v: 1 };
    const paint = () => words.setAttribute('transform', `matrix(${z.v},0,0,${z.v},${origin.x * (1 - z.v)},${origin.y * (1 - z.v)})`);
    const build = () => { layout(); paint(); };

    document.fonts.ready.then(() => {
      build();
      gsap.set(nav, { '--nav-fg': '#2A2826' });
      // arrival: the letters rise, the paper breathes
      gsap.from([w1, w2], { y: 40, opacity: 0, duration: 1.6, ease: 'silk', stagger: 0.14, delay: 0.1 });
      gsap.from(q('.nm-top, .nm-foot'), { autoAlpha: 0, y: 14, duration: 1.2, ease: 'silk', stagger: 0.1, delay: 0.6 });
      gsap.from(q('.facts, .j-mfacts'), { autoAlpha: 0, y: 24, duration: 1.2, ease: 'silk', delay: 0.8 });

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: nm, start: 'top top', end: () => '+=' + Math.round(innerHeight * 1.8), pin: true, scrub: 0.6, anticipatePin: 1, invalidateOnRefresh: true, onRefreshInit: build },
      });
      tl.set({}, {}, 100);
      tl.to(q('.nm-top, .nm-foot'), { autoAlpha: 0, y: -20, duration: 10 }, 0);
      // the fly-through: slow at first, then the "N" swallows the screen
      tl.to(z, { v: () => Math.max(40, (stage.clientWidth * 2.2) / run), duration: 62, ease: 'expo.in', onUpdate: paint }, 4);
      tl.to(q('.nm-paper'), { opacity: 0, duration: 10 }, 56);
      tl.fromTo(q('.nm-photo'), { scale: 1.25 }, { scale: 1, duration: 70, ease: 'power2.out' }, 0);
      tl.to(nav, { '--nav-fg': '#FFFFFF', duration: 6 }, 52);
      tl.set(svg, { display: 'none' }, 67);
      tl.to(q('.nm-title'), { autoAlpha: 1, duration: 1 }, 70);
      tl.from(q('.nm-title > *'), { y: 30, filter: 'blur(6px)', duration: 18, stagger: 3, ease: 'silk' }, 70);
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });
  }
</script>
