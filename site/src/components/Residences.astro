---
// Layouts by bedroom count: tabs → layout card (plan, size, R&F's own words, ask-Joey button).
// Every layout is in the page (no JS needed to reach it); the script only switches which one shows.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { wa } from '../lib/format';

type Layout = { type: string; key: string; name: string; beds: string; baths: number; sqft: number; m2?: number; text?: string; plan: ImageMetadata; note?: string };
type Group = { id: string; label: string; range: string; items: readonly Layout[]; note: string };
interface Props { groups: readonly Group[]; project: string; open: { group: string; key: string }; priceNote?: string }
const { groups, project, open, priceNote = "Ask Joey for today's price" } = Astro.props;
const bedLabel = (l: Layout) => (l.beds === 'Studio' ? 'Studio' : `${l.beds} bed`);
const ask = (l: Layout) => `Hi Joey, I'd like the price and availability of Type ${l.key} (${bedLabel(l)}, ${l.sqft} sq ft) at ${project}.`;
---
<div class="res" data-res>
  <div class="tabs" role="tablist" aria-label="Bedrooms">
    {groups.map((g) => (
      <button type="button" role="tab" id={`tab-${g.id}`} aria-selected={g.id === open.group ? 'true' : 'false'} aria-controls={`panel-${g.id}`} data-group={g.id}>
        {g.label} <em>{g.range}</em>
      </button>
    ))}
  </div>

  {groups.map((g) => (
    <div role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} data-panel={g.id} hidden={g.id !== open.group}>
      {g.items.map((l, i) => {
        const first = g.id === open.group ? l.key === open.key : i === 0;
        return (
          <article class="unit" id={`type-${l.key.toLowerCase()}`} data-key={l.key} data-ask={ask(l)} data-label={`Ask about Type ${l.key}`} hidden={!first}>
            <button class="plan" type="button" data-zoom aria-label={`Enlarge the Type ${l.key} floor plan`}>
              <Picture src={l.plan} alt={`Type ${l.key} floor plan`} widths={[480, 760, 1100]} sizes="(max-width:760px) 92vw, 46vw" formats={['avif', 'webp']} />
              <span class="zoom">Enlarge plan ⤢</span>
            </button>
            <template data-large>
              <Picture src={l.plan} alt={`Type ${l.key} floor plan, enlarged`} widths={[760, 1100, 1400]} sizes="(max-width:760px) 96vw, 60vw" formats={['avif', 'webp']} />
            </template>
            <div class="info">
              <div class="eyebrow">Type {l.type}</div>
              <h3>{l.name}<small>{bedLabel(l)} · {l.baths} bath</small></h3>
              {l.text && <p class="blurb">{l.text}</p>}
              <div class="spec">
                <div><small>Bedrooms</small><b>{l.beds === 'Studio' ? 'Studio' : l.beds}</b></div>
                <div><small>Bathrooms</small><b>{l.baths}</b></div>
                <div><small>Built-up</small><b>{l.sqft.toLocaleString('en')} sq ft</b>{l.m2 && <div class="sub">{l.m2} m²</div>}</div>
              </div>
              {l.note && <p class="small muted" style="margin:-.6rem 0 1.2rem">{l.note}</p>}
              {g.items.length > 1 && (
                <>
                  <div class="alts-l">Other {g.label.toLowerCase()} layouts</div>
                  <div class="alts">
                    {g.items.map((o) => (
                      <button type="button" data-pick={o.key} aria-pressed={o.key === l.key ? 'true' : 'false'}>{o.key} · {o.sqft.toLocaleString('en')}{o.beds.includes('study') ? ' +study' : ''}</button>
                    ))}
                  </div>
                </>
              )}
              <div class="pricebox">
                <div><div class="sub">Price for this layout</div><b>{priceNote}</b></div>
                <a class="pill dark sm" href={wa(ask(l))} target="_blank" rel="noopener"><Icon name="wa" />Ask about Type {l.key}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  ))}

  <div class="summary">
    {groups.map((g) => (<div><b>{g.label}</b><span>{g.note}</span></div>))}
  </div>

  <dialog class="sheet" data-sheet aria-label="Floor plan">
    <button class="x" type="button" data-close>Close</button>
    <div class="bd"><div class="pv" data-pv></div><div class="tx" data-tx></div></div>
  </dialog>
</div>
