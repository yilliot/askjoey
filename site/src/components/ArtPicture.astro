---
// One photo, two crops: landscape for wide screens, portrait for phones (AVIF + WebP + JPEG fallback).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props { wide: ImageMetadata; tall: ImageMetadata; alt: string; eager?: boolean; class?: string }
const { wide, tall, alt, eager = false, class: cls } = Astro.props;
const W = [960, 1440, 1920, 2560].filter((w) => w <= wide.width);
const T = [480, 760, 1080, 1440].filter((w) => w <= tall.width);
const set = async (src: ImageMetadata, ws: number[], format: 'avif' | 'webp' | 'jpg') =>
  (await Promise.all(ws.map(async (w) => `${(await getImage({ src, width: w, format, quality: format === 'avif' ? 60 : 78 })).src} ${w}w`))).join(', ');
const phone = '(max-width: 760px)';
const fallback = await getImage({ src: wide, width: 1920, format: 'jpg', quality: 80 });
---
<picture class={cls}>
  <source media={phone} type="image/avif" srcset={await set(tall, T, 'avif')} sizes="100vw" />
  <source media={phone} type="image/webp" srcset={await set(tall, T, 'webp')} sizes="100vw" />
  <source type="image/avif" srcset={await set(wide, W, 'avif')} sizes="100vw" />
  <source type="image/webp" srcset={await set(wide, W, 'webp')} sizes="100vw" />
  <img src={fallback.src} alt={alt} width={wide.width} height={wide.height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
</picture>
